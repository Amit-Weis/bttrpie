void moveToBallAt(int index) {
    // Constants for ramp geometry
    const double THETA = atan(15/1.25); // ascent angle of the ramp in rads
    const double RAMP_START_X = SORT_START_X;   // starting X coordinate (mm) for the first ball
    const double RAMP_START_Z = SORT_START_Z;     // starting z coordinate (mm) for the first ball
    const double RAMP_Y = SORT_START_Y;                  // constant Y position for all balls 
    const double BALL_DIAMETER = 32.3;   // mm

    const double X_BALL_SPACING = -BALL_DIAMETER * sin(THETA); // measure theta 
    const double Z_BALL_SPACING = -BALL_DIAMETER * cos(THETA);  

    // Calculate X and Z based on ball index
    double x = RAMP_START_X + X_BALL_SPACING * index;
    double z = RAMP_START_Z + Z_BALL_SPACING * index;
    Brain.Screen.setCursor(4,1);
    Brain.Screen.clearLine(4);
    Brain.Screen.print("[%.1f, %.1f] \n", x, z);

    // Move claw to that ball
    moveToPID(x, RAMP_Y, z);
}

