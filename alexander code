void openDoor()
{
  //array is in x, y, z

  //length is 10.
  //start (2,9,0) and end goal is (56,9,0)
  const float startCoords[3] = {60,-200,-1}; //assumes 0,0,0 is the top left corner of pool table that touches floor

  //grab();

  moveToPID(startCoords[0], startCoords[1]+150, startCoords[2]-30);
  for (int i = 0; i <=70; i+=10)
  {
      float angle = 3.1415926*i/180;
      moveToPID(startCoords[0]-150.0*sin(angle), startCoords[1]+150.0*cos(angle), startCoords[2]);
  }
  //release();
  moveToPID(startCoords[0], startCoords[1]+150, startCoords[2]-30); //raises it up to ensure it doesn't hit anything

}

void closeDoor()
{
  //array is in x, y, z
  const float startCoords[3] = {-8,-294,-1};

  // to go in reverse order, start at the 20 degree of opposite function (cosine becomes sine)
  moveToPID(startCoords[0]-100.0*cos(3.1415*20/180), startCoords[1]+180*sin(3.1415*20/180), startCoords[2]-30);

  //slowly increment change by using trigonometry
  for (int i = 20; i <=90; i+=10)
  {
    float angle = 3.1415926*i/180;
    // Since using bumper this time, needed to have it be an oval since the bumper won't be a perfect circle of travel
    moveToPID(startCoords[0]-100.0*cos(angle), startCoords[1]+180.0*sin(angle), startCoords[2]);
  }

  //end (-250,-67,-7)
  //start (76.6, -67, -7)
  //max height is -103.2

}

void moveTriangle()
{
  const float triangleStartCoords[3] = {77, -67, -7};
  const float triangleMidCoords[3] = {-250, -67, -7};
  const float triangleEndCoords[3] = {40,10,0};

  openDoor();
  release();
  moveToPID(triangleStartCoords[0], triangleStartCoords[1], triangleStartCoords[2]);
  grab();
  moveToPID(triangleMidCoords[0], triangleMidCoords[1], triangleMidCoords[2]);
  
  for (int i = 0; i <=60; i+=10)
  {
      float angle = 3.1415926*i/180;
      moveToPID(triangleMidCoords[0]+50.0*sin(angle), triangleMidCoords[1], triangleMidCoords[2]-100+100.0*cos(angle));
  }
  //release();
  moveToPID(triangleStartCoords[0], triangleStartCoords[1], triangleStartCoords[2]-90);

  // lowers it down to the original height
  moveToPID(triangleStartCoords[0], triangleStartCoords[1], triangleStartCoords[2]);

  release();

  closeDoor();
}

