void dropInTriangle(int index){
  double DROP_HEIGHT = -37;
  double DROP_X = 150.0;
  double RIGHT_Y = -10.0;
  double LEFT_Y = -100.0;
  grab();
  moveToPID(SORT_START_X, LEFT_Y, DROP_HEIGHT);
  double centreY = (LEFT_Y - RIGHT_Y)/2 + RIGHT_Y;
  double centreLeftY = (LEFT_Y - RIGHT_Y)/3 + RIGHT_Y;
  double centreRightY = (LEFT_Y - RIGHT_Y)*2/3 + RIGHT_Y;

  //centre
  if(index == 0 || index == 4){
    moveToPID(DROP_X, centreY, DROP_HEIGHT, 5);
    release();
  }
  else if(index == 1 || index == 3 || index == 6){
    moveToPID(DROP_X, LEFT_Y, DROP_HEIGHT,5);
    release();
  }
  else if(index == 2 || index == 5 || index == 9){
    moveToPID(DROP_X, RIGHT_Y, DROP_HEIGHT,5);
    release();
  }
  else if(index == 8){
    moveToPID(DROP_X, centreLeftY, DROP_HEIGHT,5);
    release();
  }
  else if(index == 7){
    moveToPID(DROP_X, centreRightY, DROP_HEIGHT,5);
    release();
  }
  wait(500,msec);
  moveToPID(SORT_START_X, LEFT_Y, DROP_HEIGHT,5);
}

