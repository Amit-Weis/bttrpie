// define variable for remote controller enable/disable
bool RemoteControlCodeEnabled = true;
// define variables used for controlling motors based on controller inputs
bool ControllerLeftShoulderControlMotorsStopped = true;
bool ControllerRightShoulderControlMotorsStopped = true;
bool eButtonsControlMotorsStopped = true;
bool fButtonsControlMotorsStopped = true;

// define a task that will handle monitoring inputs from Controller
int rc_auto_loop_function_Controller() {
  // process the controller input every 20 milliseconds
  // update the motors based on the input values
  while(true) {
    if(RemoteControlCodeEnabled) {
      // check the ButtonLUp/ButtonLDown status to control MotorX
      if (Controller.ButtonLUp.pressing()) {
        MotorX.spin(forward);
        ControllerLeftShoulderControlMotorsStopped = false;
      } else if (Controller.ButtonLDown.pressing()) {
        MotorX.spin(reverse);
        ControllerLeftShoulderControlMotorsStopped = false;
      } else if (!ControllerLeftShoulderControlMotorsStopped) {
        MotorX.stop();
        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released
        ControllerLeftShoulderControlMotorsStopped = true;
      }
      // check the ButtonRUp/ButtonRDown status to control MotorZ
      if (Controller.ButtonRUp.pressing()) {
        MotorZ.spin(forward);
        ControllerRightShoulderControlMotorsStopped = false;
      } else if (Controller.ButtonRDown.pressing()) {
        MotorZ.spin(reverse);
        ControllerRightShoulderControlMotorsStopped = false;
      } else if (!ControllerRightShoulderControlMotorsStopped) {
        MotorZ.stop();
        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released
        ControllerRightShoulderControlMotorsStopped = true;
      }
      // check the ButtonEUp/ButtonEDown status to control MotorY
      if (Controller.ButtonEUp.pressing()) {
        MotorY.spin(forward);
        eButtonsControlMotorsStopped = false;
      } else if (Controller.ButtonEDown.pressing()) {
        MotorY.spin(reverse);
        eButtonsControlMotorsStopped = false;
      } else if (!eButtonsControlMotorsStopped) {
        MotorY.stop();
        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released
        eButtonsControlMotorsStopped = true;
      }
      // check the ButtonFUp/ButtonFDown status to control MotorClaw
      if (Controller.ButtonFUp.pressing()) {
        MotorClaw.spin(forward);
        fButtonsControlMotorsStopped = false;
      } else if (Controller.ButtonFDown.pressing()) {
        MotorClaw.spin(reverse);
        fButtonsControlMotorsStopped = false;
      } else if (!fButtonsControlMotorsStopped) {
        MotorClaw.stop();
        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released
        fButtonsControlMotorsStopped = true;
      }
    }
    // wait before repeating the process
    wait(20, msec);
  }
  return 0;
}

