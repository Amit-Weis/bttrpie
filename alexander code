void sortBalls(int currentPositions[11]) {
    moveToBallAtHighHigh(0,0);
    
    for (int i = 0; i < 10; i++) {
        int targetID = goal[i];  // Get the ID we need at position i
        int foundIndex = -1;
        int lastIndex = 9 - i;

        // Find the first ball matching the target ID in the unsorted part
        for (int j = 0; j <= lastIndex; j++) {
            if (currentPositions[j] == targetID && foundIndex == -1) {
                foundIndex = j;
            }
        }

        // If we found the target ball
    
        if (foundIndex != -1) {
            // Move to that ball and grab it
          
            moveToBallAtHigh(foundIndex);
            release();
            moveToBallAt(foundIndex);
            grab();
            wait(1500,msec);
            moveToBallAtHigh(foundIndex);
            

            moveToBallAtHigh(9);
            release();

            // Save value of picked ball
            int pickedBall = currentPositions[foundIndex];

            // Shift all balls between foundIndex and end
            for (int k = foundIndex; k < 9; k++) {
                currentPositions[k] = currentPositions[k + 1];
            }

            // Place the target ball at end
            currentPositions[9] = pickedBall;
        }
        else {
          Brain.Screen.clearScreen();
          Brain.Screen.setCursor(1,1);
          Brain.Screen.print("Ball ID of %d not found", targetID);
        }
    }
}

void calibrate(){
  int NORMAL_VELOCITY = 10;
  int APPROACH_VELOCITY = 10;
  double APPROACH_DISTANCE = 0.5;     // turns

  // CALIBRATE Z:
  MotorClaw.spin(forward);
  MotorClaw.setVelocity(-20,percent);
  MotorZ.spin(forward);
  MotorZ.setVelocity(NORMAL_VELOCITY,percent);

  while(!ClawBumper.pressing()){}
  double tempPosZ = MotorZ.position(turns);
  MotorZ.setVelocity(-APPROACH_VELOCITY,percent);

  while(!(MotorZ.position(turns) <= tempPosZ - APPROACH_DISTANCE)){}
  MotorZ.setVelocity(APPROACH_VELOCITY,percent);

  while(!ClawBumper.pressing()){}
  MotorZ.setPosition(0,turns); // z-axis zeroed

  moveToPID(0,0,-4);

  // CALIBRATE Y:
  MotorY.spin(forward);
  MotorY.setVelocity(NORMAL_VELOCITY,percent);

  while(!ClawBumper.pressing()){
    moveToPIDZ(-7);
  }
  double tempPosY = MotorY.position(turns);
  MotorY.setVelocity(-APPROACH_VELOCITY,percent);

  while(!(MotorY.position(turns) <= tempPosY - APPROACH_DISTANCE)){
    moveToPIDZ(-7);
  }
  MotorY.setVelocity(APPROACH_VELOCITY,percent);

  while(!ClawBumper.pressing()){
    moveToPIDZ(-7);
  }
  MotorY.setPosition(0,turns); // y-axis zeroed
  moveToPID(0,-35, -7);

  // CALIBRATE X;
  MotorX.spin(forward);
  MotorX.setVelocity(NORMAL_VELOCITY,percent);

  while(!ClawBumper.pressing()){
    moveToPIDZ(-7);
  }
  double tempPosX = MotorX.position(turns);
  MotorX.setVelocity(-APPROACH_VELOCITY,percent);

  while(!(MotorX.position(turns) <= tempPosX - APPROACH_DISTANCE)){
    moveToPIDZ(-7);
  }
  MotorX.setVelocity(APPROACH_VELOCITY,percent);

  while(!ClawBumper.pressing()){
    moveToPIDZ(-7);
  }
  MotorX.setPosition(0,turns); // x-axis zeroed
  moveToPID(-30,-32,-70);
  MotorClaw.stop();
  MotorX.stop();
  MotorY.stop();
  MotorZ.stop();
}

