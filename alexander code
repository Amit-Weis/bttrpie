void grab(double clawClosedPosition){
  const double minClawPosition = clawClosedPosition + 10;
  MotorClaw.setVelocity(-10, percent);
  if(MotorClaw.position(degrees) > minClawPosition){
    MotorClaw.spin(reverse);
    while(MotorClaw.position(degrees) < minClawPosition){}
  }
  MotorClaw.spin(forward);
}
void release(double clawOpenPosition){
  MotorClaw.setVelocity(5, percent);
  if(MotorClaw.position(degrees) > clawOpenPosition){
    MotorClaw.spin(reverse);
    while(MotorClaw.position(degrees) > clawOpenPosition){}
    MotorClaw.stop();
  }
  else{
    MotorClaw.spin(forward);
    while(MotorClaw.position(degrees) <= clawOpenPosition){}
    MotorClaw.stop();
  }
}
void resetClaw(int degree){
  MotorClaw.setVelocity(1, percent);
  MotorClaw.spin(reverse);
  wait(500,msec);
  MotorClaw.stop(brake);
  MotorClaw.setPosition(0, degrees);
  MotorClaw.setVelocity(5, percent);
  MotorClaw.spin(forward);
  while(MotorClaw.position(degrees) <= degree){}
  MotorClaw.stop(brake);
}

// x,y,z are coordinates based on the distance from the zero point in mm
void moveTo(double x, double y, double z){
  double STOP_THRESHOLD = 1.0;
  double APPROACH_DISTANCE = 30.0;
  int NORMAL_VELOCITY = 50;
  int APPROACH_VELOCITY = 10;

  // ramp step amounts
  double ACCEL_STEP = 1.5;    // percent per cycle
  double DECEL_STEP = 2.0;    // percent per cycle

  // current dynamic motor speeds
  double velX = 0;
  double velY = 0;
  double velZ = 0;

  MotorX.spin(fwd);
  MotorY.spin(fwd);
  MotorZ.spin(fwd);

  bool done = false;
  bool doneX = false;
  bool doneY = false;
  bool doneZ = false;

  while(!done){
    double currentX = MotorX.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;
    double currentY = MotorY.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;
    double currentZ = MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z;

    double distToX = fabs(x - currentX);
    double distToY = fabs(y - currentY);
    double distToZ = fabs(z - currentZ);

    //--------------------------
    //   ACCEL / DECEL LOGIC
    //--------------------------

    // X axis
    if(!doneX){
      double targetVelX = (distToX < APPROACH_DISTANCE) ? APPROACH_VELOCITY : NORMAL_VELOCITY;

      if(distToX < STOP_THRESHOLD){
        targetVelX = 0;
      }

      // ramp velocity towards target
      if(velX < targetVelX) velX += ACCEL_STEP;
      if(velX > targetVelX) velX -= DECEL_STEP;

      // clamp
      if(velX < 0) velX = 0;
      if(velX > NORMAL_VELOCITY) velX = NORMAL_VELOCITY;

      MotorX.setVelocity(velX, percent);

      if(targetVelX == 0){
        MotorX.stop();
        doneX = true;
      }
    }

    // Y axis
    if(!doneY){
      double targetVelY = (distToY < APPROACH_DISTANCE) ? APPROACH_VELOCITY : NORMAL_VELOCITY;
      if(distToY < STOP_THRESHOLD) targetVelY = 0;

      if(velY < targetVelY) velY += ACCEL_STEP;
      if(velY > targetVelY) velY -= DECEL_STEP;

      if(velY < 0) velY = 0;
      if(velY > NORMAL_VELOCITY) velY = NORMAL_VELOCITY;

      MotorY.setVelocity(velY, percent);

      if(targetVelY == 0){
        MotorY.stop();
        doneY = true;
      }
    }

    // Z axis
    if(!doneZ){
      double targetVelZ = (distToZ < APPROACH_DISTANCE) ? APPROACH_VELOCITY : NORMAL_VELOCITY;
      if(distToZ < STOP_THRESHOLD) targetVelZ = 0;

      if(velZ < targetVelZ) velZ += ACCEL_STEP;
      if(velZ > targetVelZ) velZ -= DECEL_STEP;

      if(velZ < 0) velZ = 0;
      if(velZ > NORMAL_VELOCITY) velZ = NORMAL_VELOCITY;

      MotorZ.setVelocity(velZ, percent);

      if(targetVelZ == 0){
        MotorZ.stop();
        doneZ = true;
      }
    }

    //--------------------------
    //   END CONDITION
    //--------------------------
    if(doneX && doneY && doneZ){
      done = true;
    }

    wait(20, msec);  // small delay makes ramping smooth
  }
}

// x,y,z are coordinates based on the distance from the zero point in mm
void moveToPID(double x, double y, double z) {
  Brain.Screen.clearLine(1);
  Brain.Screen.setCursor(1,1);
  Brain.Screen.print("[%.2f, %.2f, %.2f]", x,y,z);
  //  PID constants (tune these per axis) 
  double kP_X = 1.5, kI_X = 0.0006, kD_X = 0.25;
  double kP_Y = 2, kI_Y = 0.0006, kD_Y = 0.25;
  double kP_Z = 2, kI_Z = 0.0003, kD_Z = 0.25;

  //  control loop parameters 
  const double STOP_THRESHOLD = 1;  // mm tolerance
  const int MAX_POWER = 100;          // percent
  const int LOOP_DELAY = 20;          // ms

  //  PID state variables 
  double errorX = 0, prevErrorX = 0, integralX = 0;
  double errorY = 0, prevErrorY = 0, integralY = 0;
  double errorZ = 0, prevErrorZ = 0, integralZ = 0;

  //  Start moving (direction handled by power sign) 
  MotorX.spin(forward);
  MotorY.spin(forward);
  MotorZ.spin(forward);

  while (true) {
    Brain.Screen.clearLine(2);
    Brain.Screen.setCursor(2,1);
      //  Get current positions in mm 
    double currentX = MotorX.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;
    double currentY = MotorY.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;
    double currentZ = MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z;
    Brain.Screen.print("[%.1f, %.1f, %.1f]", currentX,currentY,currentZ);

    Brain.Screen.clearLine(3);
    Brain.Screen.setCursor(3,1);
    Brain.Screen.print("PIDing");

    //  Calculate errors 
    errorX = x - currentX;
    errorY = y - currentY;
    errorZ = z - currentZ;

    //  Accumulate integral and calculate derivative 
    integralX += errorX;
    integralY += errorY;
    integralZ += errorZ;

    double derivativeX = errorX - prevErrorX;
    double derivativeY = errorY - prevErrorY;
    double derivativeZ = errorZ - prevErrorZ;

    //  PID output (motor power) 
    double powerX = (kP_X * errorX) + (kI_X * integralX) + (kD_X * derivativeX);
    double powerY = (kP_Y * errorY) + (kI_Y * integralY) + (kD_Y * derivativeY);
    double powerZ = (kP_Z * errorZ) + (kI_Z * integralZ) + (kD_Z * derivativeZ);


    //  Clamp motor power 
    //powerX = min(MAX_POWER, max(powerX, -MAX_POWER));
    //powerY = min(MAX_POWER, max(powerY, -MAX_POWER));
    //powerZ = min(MAX_POWER, max(powerZ, -MAX_POWER));
    powerX = clamp(powerX, -MAX_POWER/1.25, MAX_POWER/1.25); // min(MAX_POWER, max(powerX,-MAX_POWER))
    powerY = clamp(powerY, -MAX_POWER, MAX_POWER);
    powerZ = clamp(powerZ, -MAX_POWER/1.25, MAX_POWER/1.25);

    //  Store previous errors 
    prevErrorX = errorX;
    prevErrorY = errorY;
    prevErrorZ = errorZ;

    //  Exit condition: all axes within threshold 
    if (fabs(errorX) < STOP_THRESHOLD &&
        fabs(errorY) < STOP_THRESHOLD &&
        fabs(errorZ) < STOP_THRESHOLD) {
      break;
    }

    //  stop motors if they are within thresholds 

    if (fabs(errorX) < STOP_THRESHOLD) {
      powerX = 0;
    }
     if (fabs(errorY) < STOP_THRESHOLD) {
      powerY = 0;
    }
    if (fabs(errorZ) < STOP_THRESHOLD) {
      powerZ = 0;
    }


    //  Apply to motors 
    MotorX.setVelocity(powerX, percent);
    MotorY.setVelocity(powerY, percent);
    MotorZ.setVelocity(powerZ, percent);

    MotorX.spin(forward);
    MotorY.spin(forward);
    MotorZ.spin(forward);


    wait(LOOP_DELAY, msec);


  }
  MotorX.stop();
  MotorY.stop();
  MotorZ.stop();
  Brain.Screen.clearLine(3);
}

