{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor MotorX = motor(PORT4, true);\nmotor MotorZ = motor(PORT6, true);\nmotor MotorY = motor(PORT12, false);\nbumper ClawBumper = bumper(PORT5);\nmotor MotorClaw = motor(PORT9, false);\ncontroller Controller = controller();\noptical Optical1 = optical(PORT1);\ntouchled TouchLED = touchled(PORT3);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n// Converts a color to a string\nconst char* convertColorToString(color col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\n// Convert colorType to string\nconst char* convertColorToString(colorType col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool ControllerLeftShoulderControlMotorsStopped = true;\nbool ControllerRightShoulderControlMotorsStopped = true;\nbool eButtonsControlMotorsStopped = true;\nbool fButtonsControlMotorsStopped = true;\n\n// define a task that will handle monitoring inputs from Controller\nint rc_auto_loop_function_Controller() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      // check the ButtonLUp/ButtonLDown status to control MotorX\n      if (Controller.ButtonLUp.pressing()) {\n        MotorX.spin(forward);\n        ControllerLeftShoulderControlMotorsStopped = false;\n      } else if (Controller.ButtonLDown.pressing()) {\n        MotorX.spin(reverse);\n        ControllerLeftShoulderControlMotorsStopped = false;\n      } else if (!ControllerLeftShoulderControlMotorsStopped) {\n        MotorX.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        ControllerLeftShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonRUp/ButtonRDown status to control MotorZ\n      if (Controller.ButtonRUp.pressing()) {\n        MotorZ.spin(forward);\n        ControllerRightShoulderControlMotorsStopped = false;\n      } else if (Controller.ButtonRDown.pressing()) {\n        MotorZ.spin(reverse);\n        ControllerRightShoulderControlMotorsStopped = false;\n      } else if (!ControllerRightShoulderControlMotorsStopped) {\n        MotorZ.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        ControllerRightShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonEUp/ButtonEDown status to control MotorY\n      if (Controller.ButtonEUp.pressing()) {\n        MotorY.spin(forward);\n        eButtonsControlMotorsStopped = false;\n      } else if (Controller.ButtonEDown.pressing()) {\n        MotorY.spin(reverse);\n        eButtonsControlMotorsStopped = false;\n      } else if (!eButtonsControlMotorsStopped) {\n        MotorY.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        eButtonsControlMotorsStopped = true;\n      }\n      // check the ButtonFUp/ButtonFDown status to control MotorClaw\n      if (Controller.ButtonFUp.pressing()) {\n        MotorClaw.spin(forward);\n        fButtonsControlMotorsStopped = false;\n      } else if (Controller.ButtonFDown.pressing()) {\n        MotorClaw.spin(reverse);\n        fButtonsControlMotorsStopped = false;\n      } else if (!fButtonsControlMotorsStopped) {\n        MotorClaw.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        fButtonsControlMotorsStopped = true;\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller(rc_auto_loop_function_Controller);\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n#include \"algorithm\"\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n//============================================================================\n// CONSTANTS\n//============================================================================\n\n// Mechanical constants\nconst double TOOTH_PITCH_MM = 4.712;\nconst int NUM_TEETH_XY = 12;\nconst int NUM_TEETH_Z = 10;\nconst double BALL_DIAMETER = 32.3;\n\n// Starting position for ball sorting\nconst double SORT_START_X = 425.0;\nconst double SORT_START_Y = -228.0;\nconst double SORT_START_Z = 136.0;\n\n// Ramp geometry\nconst double RAMP_THETA = atan(15.0 / 1.25);\nconst double X_BALL_SPACING = -BALL_DIAMETER * sin(RAMP_THETA);\nconst double Z_BALL_SPACING = -BALL_DIAMETER * cos(RAMP_THETA);\n\n// Goal configuration: 1=red, 2=blue, 3=white, 4=black\nconst int goal[11] = {1, 4, 4, 2, 1, 2, 1, 2, 1, 2, 3};\n\n// PID constants\nconst double KP_X = 1.5, KI_X = 0.0006, KD_X = 0.25;\nconst double KP_Y = 2.0, KI_Y = 0.0006, KD_Y = 0.25;\nconst double KP_Z = 2.0, KI_Z = 0.0003, KD_Z = 0.25;\nconst double STOP_THRESHOLD = 1.0;\nconst int MAX_POWER = 100;\nconst int LOOP_DELAY = 20;\n\n// Positions for dropping balls into triangle\ndouble const DROP_HEIGHT = -37;\ndouble const DROP_Y_RIGHT = -10.0;\ndouble const DROP_Y_LEFT = -100.0;\ndouble const DROP_X = 145.0;\ndouble const CENTER_Y = (DROP_Y_LEFT + DROP_Y_RIGHT) / 2;\ndouble const CENTER_LEFT_Y = DROP_Y_LEFT + (DROP_Y_RIGHT - DROP_Y_LEFT) / 3;\ndouble const CENTER_RIGHT_Y = DROP_Y_LEFT + (DROP_Y_RIGHT - DROP_Y_LEFT) * 2 / 3;\n\n//============================================================================\n// FUNCTION PROTOTYPES\n//============================================================================\n\n// Utility\ndouble clamp(double val, double low, double high);\ndouble min(double a, double b);\nvoid waitForTouchLED();\nvoid waitHold(double secs);\nvoid reset();\n\n// Claw control\nvoid release();\nvoid grab();\n\n// Movement\nvoid moveToPIDZ(double z);\nvoid moveToPID(double x, double y, double z, int rampUpTime = 0);\n\nvoid moveToBallAt(int index);\nvoid moveToBallAtHigh(int index, bool higher = false);\n\n// Color detection\nint colorToID();\n\nvoid collectColours(int currentPositions[11]);\n\n// Sorting\nvoid sortBalls(int currentPositions[11]);\n\n// Placement \nvoid dropInTriangle(int index);\nvoid place();\n\n// Door and Triangle\nvoid openDoor();\nvoid closeDoor();\nvoid moveTriangle();\n\n// calibration\nvoid calibrate();\n\n//============================================================================\n// UTILITY FUNCTIONS\n//============================================================================\n\ndouble clamp(double val, double low, double high) {\n    if (val > high) return high;\n    if (val < low) return low;\n    return val;\n}\n\ndouble min(double a, double b) {\n    return (a < b) ? a : b;\n}\n\nvoid waitForTouchLED() {\n  while(!TouchLED.pressing()){\n    moveToPIDZ(MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z);\n  }\n  while(TouchLED.pressing()){\n    moveToPIDZ(MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z);\n  }\n}\n\nvoid waitHold(double secs) {\n  Brain.Timer.reset();\n  while(Brain.Timer.value() < secs){\n    moveToPIDZ(MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z);\n  }\n}\n\nvoid reset() {\n  moveToPID(-50,-50,-30);\n  grab();\n}\n\n//============================================================================\n// CLAW CONTROL\n//============================================================================\n\nvoid release() {\n  // set claw motor to open\n  MotorClaw.setVelocity(10, percent);\n  MotorClaw.spin(forward); \n\n  // Hold Z axis up to its current position while waiting for claw to release\n  Brain.Timer.reset();\n  while(Brain.Timer.value() < 0.03) {\n    moveToPIDZ(MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z);\n  }\n}\n\nvoid grab() {\n  // set claw motor to close\n  MotorClaw.setVelocity(-10, percent);\n  MotorClaw.spin(forward); \n  \n  // Hold Z axis up to its current position while waiting for claw to release\n  Brain.Timer.reset();\n  while(Brain.Timer.value() < 0.5){\n    moveToPIDZ(MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z);\n  }\n  \n  // keep holding object\n  MotorClaw.setVelocity(-20, percent); \n}\n\n//============================================================================\n// MOVEMENT FUNCTIONS\n//============================================================================\n// Note x,y,z are all in mm based on the origin point calibrated in calibrate()\n// rampUpTime is in seconds\n\nvoid moveToPIDZ(double z) {\n    // Debugging prints\n    // Brain.Screen.clearLine(1);\n    // Brain.Screen.setCursor(1, 1);\n    // Brain.Screen.print(\"[%.2f]\", z);\n    \n    //Init Variables and motor condition\n    double errorZ = 0, prevErrorZ = 0, integralZ = 0;\n    MotorZ.spin(forward);\n\n    bool arrived = false;\n    while (!arrived) {\n        // Calculate current position\n        double currentZ = MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z;\n        \n        // Debugging prints\n        // Brain.Screen.clearLine(2);\n        // Brain.Screen.setCursor(2, 1);\n        // Brain.Screen.print(\"[%.1f]\", currentZ);\n\n        // Calculate current error\n        errorZ = z - currentZ;\n        integralZ += errorZ;\n        double derivativeZ = errorZ - prevErrorZ;\n\n        // Calculate current power based on error\n        double powerZ = (KP_Z * errorZ) + (KI_Z * integralZ) + (KD_Z * derivativeZ);\n        powerZ = clamp(powerZ, -MAX_POWER / 1.5, MAX_POWER / 1.5);\n\n        // Store previous error for next loop\n        prevErrorZ = errorZ;\n\n        // Stop within the defined stop_threshold\n        if (fabs(errorZ) < STOP_THRESHOLD) {\n            arrived = true;\n        } \n\n        // If not arrived, continue\n        else {\n          // Apply calculated power\n          MotorZ.setVelocity(powerZ, percent);\n          MotorZ.spin(forward);\n          wait(LOOP_DELAY, msec);\n        }\n    }\n\n    // Stop the motor once arrived\n    MotorZ.stop();\n}\n\nvoid moveToPID(double x, double y, double z, int rampUpTime) {\n    // Debugging prints\n    // Brain.Screen.clearLine(1);\n    // Brain.Screen.setCursor(1, 1);\n    // Brain.Screen.print(\"[%.2f, %.2f, %.2f]\", x, y, z);\n\n    // Timer for ramp-up\n    if (rampUpTime > 0) {\n        Brain.Timer.reset();\n    }\n\n    // Init PID variables\n    double errorX = 0, prevErrorX = 0, integralX = 0;\n    double errorY = 0, prevErrorY = 0, integralY = 0;\n    double errorZ = 0, prevErrorZ = 0, integralZ = 0;\n\n    // Motors start spinning\n    MotorX.spin(forward);\n    MotorY.spin(forward);\n    MotorZ.spin(forward);\n\n    bool arrived = false;\n\n    while (!arrived) {\n\n        // Get current positions\n        double currentX = MotorX.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;\n        double currentY = MotorY.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;\n        double currentZ = MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z;\n\n        // Debug prints\n        // Brain.Screen.clearLine(2);\n        // Brain.Screen.setCursor(2, 1);\n        // Brain.Screen.print(\"[%.1f, %.1f, %.1f]\", currentX, currentY, currentZ);\n\n        // Compute error\n        errorX = x - currentX;\n        errorY = y - currentY;\n        errorZ = z - currentZ;\n\n        // Integrals\n        integralX += errorX;\n        integralY += errorY;\n        integralZ += errorZ;\n\n        // Derivatives\n        double derivativeX = errorX - prevErrorX;\n        double derivativeY = errorY - prevErrorY;\n        double derivativeZ = errorZ - prevErrorZ;\n\n        // PID output\n        double powerX = (KP_X * errorX) + (KI_X * integralX) + (KD_X * derivativeX);\n        double powerY = (KP_Y * errorY) + (KI_Y * integralY) + (KD_Y * derivativeY);\n        double powerZ = (KP_Z * errorZ) + (KI_Z * integralZ) + (KD_Z * derivativeZ);\n\n        // Optional ramp-up\n        if (rampUpTime > 0) {\n            double rampFactor = min(1.0, Brain.Timer.value() / rampUpTime);\n            powerX *= rampFactor;\n            powerY *= rampFactor;\n            powerZ *= 1;\n        }\n\n        // Clamp power\n        powerX = clamp(powerX, -MAX_POWER / 1.25, MAX_POWER / 1.25);\n        powerY = clamp(powerY, -MAX_POWER,       MAX_POWER);\n        powerZ = clamp(powerZ, -MAX_POWER / 1.25, MAX_POWER / 1.25);\n\n        // Save old error\n        prevErrorX = errorX;\n        prevErrorY = errorY;\n        prevErrorZ = errorZ;\n\n        // Stop condition\n        if (fabs(errorX) < STOP_THRESHOLD &&\n            fabs(errorY) < STOP_THRESHOLD &&\n            fabs(errorZ) < STOP_THRESHOLD) \n        {\n            arrived = true;\n        }\n\n        // If not arrived apply power and continue\n        else {\n            MotorX.setVelocity(powerX, percent);\n            MotorY.setVelocity(powerY, percent);\n            MotorZ.setVelocity(powerZ, percent);\n\n            MotorX.spin(forward);\n            MotorY.spin(forward);\n            MotorZ.spin(forward);\n\n            wait(LOOP_DELAY, msec);\n        }\n    }\n\n    // Stop all motors once arrived\n    MotorX.stop();\n    MotorY.stop();\n    MotorZ.stop();\n}\n\nvoid moveToBallAt(int index) {\n    // Calculate X and Z based on ball index\n    double x = SORT_START_X + X_BALL_SPACING * index;\n    double z = SORT_START_Z + Z_BALL_SPACING * index;\n    \n    moveToPID(x, SORT_START_Y, z);\n}\n\nvoid moveToBallAtHigh(int index, bool higher) {\n    // Calculate X and Z based on ball index\n    double x = SORT_START_X + X_BALL_SPACING * index;\n    double z = SORT_START_Z + Z_BALL_SPACING * index;\n\n    // Move claw to that ball with a height based on higher\n    if (!higher) {\n      moveToPID(x, SORT_START_Y, z-BALL_DIAMETER,5);\n    } \n    else {\n      moveToPID(x, SORT_START_Y, -25, 5);\n    }\n}\n\n//============================================================================\n// COLOR DETECTION\n//============================================================================\n\nint colorToID() {\n    double h = Optical1.hue();\n    double b = Optical1.brightness();\n\n    // RED\n    if (h >= 0 && h <= 109 && b >= 30 && b <= 100) return 1;\n    // BLUE\n    if (h >= 110 && h <= 260 && b >= 30 && b <= 100) return 2;\n    // WHITE\n    if (b >= 81 && b <= 100) return 3;\n    // BLACK\n    if (b >= 0 && b <= 29) return 4;\n\n    return 0; // Unknown\n}\n\nvoid collectColours(int currentPositions[11]) {\n    Optical1.setLight(ledState::on);\n    Optical1.setLightPower(100,percent);\n    \n    // move in a specific way to avoid hitting the table\n    grab();\n    moveToBallAtHigh(8, true);\n    moveToBallAtHigh(0);\n    \n    // release and wait for the claw to open\n    release();\n    wait(1000, msec);\n\n    for (int i = 0; i <= 9; i++) {\n        // Move claw/sensor to current ball position and wait for it to stablize areading\n        moveToBallAt(i);\n        wait(300, msec);\n\n        // Store ID in array\n        currentPositions[i] =  colorToID();\n    }\n\n    // Debug print\n    // Brain.Screen.clearLine(5);\n    // Brain.Screen.setCursor(5,1);\n    // for(int i = 0; i < 10; i++) {\n    //     Brain.Screen.print(\"%d, \", currentPositions[i]);\n    //     if(i == 4) {           \n    //         Brain.Screen.newLine();\n    //     }\n    // }\n    Optical1.setLight(ledState::off);\n}\n\n//============================================================================\n// SORTING\n//============================================================================\n\nvoid sortBalls(int currentPositions[11]) {\n    moveToBallAtHigh(0, true);\n    \n    for (int i = 0; i < 10; i++) {\n        int targetID = goal[i];  // Get the ID we need at position i\n        int foundIndex = -1;\n        int lastIndex = 9 - i;\n\n        // Find the first ball matching the target ID in the unsorted part\n        for (int j = 0; j <= lastIndex; j++) {\n            if (currentPositions[j] == targetID && foundIndex == -1) {\n                foundIndex = j;\n            }\n        }\n\n        // If we found the target ball\n    \n        if (foundIndex != -1) {\n            // Move to that ball and grab it\n            moveToBallAtHigh(foundIndex);\n            release();\n            moveToBallAt(foundIndex);\n            grab();\n            wait(500,msec);\n            moveToBallAtHigh(foundIndex);\n            \n\n            moveToBallAtHigh(9);\n            release();\n\n            // Save value of picked ball\n            int pickedBall = currentPositions[foundIndex];\n\n            // Shift array\n            for (int k = foundIndex; k < 9; k++) {\n                currentPositions[k] = currentPositions[k + 1];\n            }\n\n            // Place the picked ball at end\n            currentPositions[9] = pickedBall;\n        }\n        else {\n          // Debug print\n          // Brain.Screen.clearScreen();\n          // Brain.Screen.setCursor(1,1);\n          // Brain.Screen.print(\"Ball ID of %d not found\", targetID);\n        }\n    }\n}\n\n//============================================================================\n// PLACEMENT FUNCTIONS\n//============================================================================\n\nvoid dropInTriangle(int index) {\n    // Assuming we are already at the ball, grab it and move to start  \n    grab();\n    moveToPID(SORT_START_X, DROP_Y_LEFT, DROP_HEIGHT);\n\n    // Based on the index of the ball, place it it at a specific point\n    if (index == 0 || index == 4) {\n        moveToPID(DROP_X - 32, CENTER_Y, DROP_HEIGHT, 5);\n    } else if (index == 1 || index == 3 || index == 6) {\n        moveToPID(DROP_X, DROP_Y_LEFT, DROP_HEIGHT, 5);\n    } else if (index == 2 || index == 5 || index == 9) {\n        moveToPID(DROP_X, DROP_Y_RIGHT, DROP_HEIGHT, 5);\n    } else if (index == 8) {\n        moveToPID(DROP_X, CENTER_LEFT_Y, DROP_HEIGHT, 5);\n    } else if (index == 7) {\n        moveToPID(DROP_X, CENTER_RIGHT_Y, DROP_HEIGHT, 5);\n    }\n\n    // Drop the ball and wait for it to fall\n    release();\n    waitHold(0.5);\n\n    // Move back to ramp\n    moveToPID(SORT_START_X, DROP_Y_LEFT, DROP_HEIGHT, 5);\n}\n\nvoid place() {\n  // move to the first ball\n  grab();\n  moveToBallAtHigh(0);\n  release();\n\n  // start placing them\n  for(int i = 0; i < 10; i++){\n    moveToBallAt(0);\n    dropInTriangle(i);\n  }\n}\n\n//============================================================================\n// DOOR AND TRIANGLE FUNCTIONS\n//============================================================================\n\nvoid openDoor() {\n    // Constants\n    const double START_X = 60;\n    const double START_Y = -200;\n    const double START_Z = -1;\n\n    const double HINGE_RADIUS_X = 150;   // motion left-right\n    const double HINGE_RADIUS_Y = 150;   // motion forward-back\n    const double DROP_Z = 30;            // how much to dip during approach\n    const int   SWEEP_START = 0;\n    const int   SWEEP_END   = 70;\n    const int   SWEEP_STEP  = 10;\n\n    // Initial approach \n    moveToPID(START_X, START_Y + HINGE_RADIUS_Y, START_Z - DROP_Z);\n\n    // Arc motion \n    for (int i = SWEEP_START; i <= SWEEP_END; i += SWEEP_STEP) {\n        double angle = 3.1415926 * i / 180.0;\n\n        double targetX = START_X - HINGE_RADIUS_X * sin(angle);\n        double targetY = START_Y + HINGE_RADIUS_Y * cos(angle);\n        double targetZ = START_Z;\n\n        moveToPID(targetX, targetY, targetZ);\n    }\n\n    // Retreat dip \n    moveToPID(START_X, START_Y + HINGE_RADIUS_Y, START_Z - DROP_Z);\n}\n\nvoid closeDoor() {\n    // Constants \n    const double START_X = -8;\n    const double START_Y = -294;\n    const double START_Z = -1;\n\n    const double RADIUS_X = 100;\n    const double RADIUS_Y = 180;\n    const double DROP_Z   = 30;\n\n    const int FIRST_ANGLE = 20;\n    const int SWEEP_START = 20;\n    const int SWEEP_END   = 90;\n    const int SWEEP_STEP  = 10;\n\n    // Initial dip near 20° \n    double firstAngle = 3.1415 * FIRST_ANGLE / 180.0;\n    moveToPID(START_X - RADIUS_X * cos(firstAngle),\n              START_Y + RADIUS_Y * sin(firstAngle),\n              START_Z - DROP_Z);\n\n    // Arc sweep \n    for (int i = SWEEP_START; i <= SWEEP_END; i += SWEEP_STEP) {\n        double angle = 3.1415926 * i / 180.0;\n\n        double targetX = START_X - RADIUS_X * cos(angle);\n        double targetY = START_Y + RADIUS_Y * sin(angle);\n        double targetZ = START_Z;\n\n        moveToPID(targetX, targetY, targetZ);\n    }\n}\n\nvoid moveTriangle() {\n    // move triangle in a specifc manner that aligns it past the door and straightly\n    release();\n    moveToPID(63.6, -60.7, -4.5);\n    grab();\n    wait(300, msec);\n    \n    moveToPID(-265, -60.7, -4.5);\n    wait(300, msec);\n    \n    moveToPID(-265, -168, -4.5);\n    wait(300, msec);\n    \n    moveToPID(-265, -102, -4.5);\n    release();\n    \n    moveToPID(-300, -102, -50);\n    waitForTouchLED();\n    \n    closeDoor();\n}\n\n//============================================================================\n// CALIBRATION\n//============================================================================\n\nvoid calibrate() {\n  int NORMAL_VELOCITY = 10;\n  int APPROACH_VELOCITY = 10;\n  double APPROACH_DISTANCE = 0.5;     // turns\n\n  // CALIBRATE Z:\n  MotorClaw.spin(forward);\n  MotorClaw.setVelocity(-20,percent);\n  MotorZ.spin(forward);\n  MotorZ.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  double tempPosZ = MotorZ.position(turns);\n  MotorZ.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorZ.position(turns) <= tempPosZ - APPROACH_DISTANCE)){}\n  MotorZ.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  MotorZ.setPosition(0,turns); // z-axis zeroed\n\n  moveToPID(0,0,-4);\n\n  // CALIBRATE Y:\n  MotorY.spin(forward);\n  MotorY.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-7);\n  }\n  double tempPosY = MotorY.position(turns);\n  MotorY.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorY.position(turns) <= tempPosY - APPROACH_DISTANCE)){\n    moveToPIDZ(-7);\n  }\n  MotorY.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-7);\n  }\n  MotorY.setPosition(0,turns); // y-axis zeroed\n  moveToPID(0,-35, -7);\n\n  // CALIBRATE X;\n  MotorX.spin(forward);\n  MotorX.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-7);\n  }\n  double tempPosX = MotorX.position(turns);\n  MotorX.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorX.position(turns) <= tempPosX - APPROACH_DISTANCE)){\n    moveToPIDZ(-7);\n  }\n  MotorX.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-7);\n  }\n  MotorX.setPosition(0,turns); // x-axis zeroed\n  moveToPID(-30,-32,-70);\n  MotorClaw.stop();\n  MotorX.stop();\n  MotorY.stop();\n  MotorZ.stop();\n}\n\n//============================================================================\n// MAIN PROGRAM\n//============================================================================\n\nint main(){\n  vexcodeInit();\n  Brain.Screen.clearScreen();\n  Brain.Screen.setFont(mono15);\n  int currentPositions[11] = {0};\n\n  waitHold(5);\n  calibrate();\n  Brain.Screen.clearLine(1);\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"Collect colors\");\n\n  waitHold(1);\n  collectColours(currentPositions);\n\n  Brain.Screen.clearLine(1);\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"sort balls\");\n\n  waitHold(1);\n  sortBalls(currentPositions);\n\n  Brain.Screen.clearLine(1);\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"place balls\");\n\n  waitHold(1);\n  release();\n  moveToBallAtHigh(0,true);\n  place();\n    \n  Brain.Screen.clearLine(1);\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"Move Triangle\");\n\n  waitHold(1);\n  moveToPID(DROP_X, DROP_Y_LEFT, DROP_HEIGHT);\n  moveTriangle();\n  closeDoor();\n  moveToPID(SORT_START_X, DROP_Y_LEFT, DROP_HEIGHT);\n\n  Brain.Screen.clearLine(1);\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"reset\");\n\n  waitForTouchLED();\n  reset();\n  Brain.programStop();\n}\n","textLanguage":"cpp","robotConfig":[{"port":[4],"name":"MotorX","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[6],"name":"MotorZ","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[12],"name":"MotorY","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[5],"name":"ClawBumper","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[9],"name":"MotorClaw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"MotorX","leftDir":"false","right":"MotorZ","rightDir":"false","e":"MotorY","eDir":"false","f":"MotorClaw","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[1],"name":"Optical1","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{},"triportSourcePort":22},{"port":[3],"name":"TouchLED","customName":true,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":""}}