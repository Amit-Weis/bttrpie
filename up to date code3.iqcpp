{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor MotorX = motor(PORT4, true);\nmotor MotorZ = motor(PORT6, true);\nmotor MotorY = motor(PORT12, false);\nbumper ClawBumper = bumper(PORT2);\nmotor MotorClaw = motor(PORT9, false);\ncontroller Controller = controller();\noptical Optical1 = optical(PORT1);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n// Converts a color to a string\nconst char* convertColorToString(color col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\n// Convert colorType to string\nconst char* convertColorToString(colorType col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool ControllerLeftShoulderControlMotorsStopped = true;\nbool ControllerRightShoulderControlMotorsStopped = true;\nbool eButtonsControlMotorsStopped = true;\nbool fButtonsControlMotorsStopped = true;\n\n// define a task that will handle monitoring inputs from Controller\nint rc_auto_loop_function_Controller() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      // check the ButtonLUp/ButtonLDown status to control MotorX\n      if (Controller.ButtonLUp.pressing()) {\n        MotorX.spin(forward);\n        ControllerLeftShoulderControlMotorsStopped = false;\n      } else if (Controller.ButtonLDown.pressing()) {\n        MotorX.spin(reverse);\n        ControllerLeftShoulderControlMotorsStopped = false;\n      } else if (!ControllerLeftShoulderControlMotorsStopped) {\n        MotorX.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        ControllerLeftShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonRUp/ButtonRDown status to control MotorZ\n      if (Controller.ButtonRUp.pressing()) {\n        MotorZ.spin(forward);\n        ControllerRightShoulderControlMotorsStopped = false;\n      } else if (Controller.ButtonRDown.pressing()) {\n        MotorZ.spin(reverse);\n        ControllerRightShoulderControlMotorsStopped = false;\n      } else if (!ControllerRightShoulderControlMotorsStopped) {\n        MotorZ.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        ControllerRightShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonEUp/ButtonEDown status to control MotorY\n      if (Controller.ButtonEUp.pressing()) {\n        MotorY.spin(forward);\n        eButtonsControlMotorsStopped = false;\n      } else if (Controller.ButtonEDown.pressing()) {\n        MotorY.spin(reverse);\n        eButtonsControlMotorsStopped = false;\n      } else if (!eButtonsControlMotorsStopped) {\n        MotorY.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        eButtonsControlMotorsStopped = true;\n      }\n      // check the ButtonFUp/ButtonFDown status to control MotorClaw\n      if (Controller.ButtonFUp.pressing()) {\n        MotorClaw.spin(forward);\n        fButtonsControlMotorsStopped = false;\n      } else if (Controller.ButtonFDown.pressing()) {\n        MotorClaw.spin(reverse);\n        fButtonsControlMotorsStopped = false;\n      } else if (!fButtonsControlMotorsStopped) {\n        MotorClaw.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        fButtonsControlMotorsStopped = true;\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller(rc_auto_loop_function_Controller);\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n#include \"algorithm\"\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n// 1 = red\n// 2 = blue \n// 3 = black \n// 4 = white \nconst int goal[11] =    {1,\n                        4,4,\n                       2,1,2,\n                      1,2,1,2,\n                         3};\n\nvoid grab();\nvoid release();\ndouble const TOOTH_PITCH_MM = 4.712;\nint const NUM_TEETH_XY = 12;\nint const NUM_TEETH_Z = 10;\ndouble const SORT_START_X = 420.0;\ndouble const SORT_START_Y = -228.0;\ndouble const SORT_START_Z = 136;\n\nfloat clamp(float val, float low, float high){\n    if (val > high){\n        return high;\n    }\n    else {\n        if (val < low){\n            return low;\n        }\n        else {\n            return val;\n        }\n    }\n}\n\nvoid grab(double clawClosedPosition){\n  const double minClawPosition = clawClosedPosition + 10;\n  MotorClaw.setVelocity(-10, percent);\n  if(MotorClaw.position(degrees) > minClawPosition){\n    MotorClaw.spin(reverse);\n    while(MotorClaw.position(degrees) < minClawPosition){}\n  }\n  MotorClaw.spin(forward);\n}\nvoid release(double clawOpenPosition){\n  MotorClaw.setVelocity(5, percent);\n  if(MotorClaw.position(degrees) > clawOpenPosition){\n    MotorClaw.spin(reverse);\n    while(MotorClaw.position(degrees) > clawOpenPosition){}\n    MotorClaw.stop();\n  }\n  else{\n    MotorClaw.spin(forward);\n    while(MotorClaw.position(degrees) <= clawOpenPosition){}\n    MotorClaw.stop();\n  }\n}\nvoid resetClaw(int degree){\n  MotorClaw.setVelocity(1, percent);\n  MotorClaw.spin(reverse);\n  wait(500,msec);\n  MotorClaw.stop(brake);\n  MotorClaw.setPosition(0, degrees);\n  MotorClaw.setVelocity(5, percent);\n  MotorClaw.spin(forward);\n  while(MotorClaw.position(degrees) <= degree){}\n  MotorClaw.stop(brake);\n}\n\n// x,y,z are coordinates based on the distance from the zero point in mm\nvoid moveToPID(double x, double y, double z) {\n  Brain.Screen.clearLine(1);\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"[%.2f, %.2f, %.2f]\", x,y,z);\n  //  PID constants (tune these per axis) \n  double kP_X = 2, kI_X = 0.0006, kD_X = 0.25;\n  double kP_Y = 2, kI_Y = 0.0006, kD_Y = 0.25;\n  double kP_Z = 2, kI_Z = 0.0003, kD_Z = 0.25;\n\n  //  control loop parameters \n  const double STOP_THRESHOLD = 1;  // mm tolerance\n  const int MAX_POWER = 75;          // percent\n  const int LOOP_DELAY = 20;          // ms\n\n  //  PID state variables \n  double errorX = 0, prevErrorX = 0, integralX = 0;\n  double errorY = 0, prevErrorY = 0, integralY = 0;\n  double errorZ = 0, prevErrorZ = 0, integralZ = 0;\n\n  //  Start moving (direction handled by power sign) \n  MotorX.spin(forward);\n  MotorY.spin(forward);\n  MotorZ.spin(forward);\n\n  while (true) {\n    Brain.Screen.clearLine(2);\n    Brain.Screen.setCursor(2,1);\n      //  Get current positions in mm \n    double currentX = MotorX.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;\n    double currentY = MotorY.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;\n    double currentZ = MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z;\n    Brain.Screen.print(\"[%.1f, %.1f, %.1f]\", currentX,currentY,currentZ);\n\n    Brain.Screen.clearLine(3);\n    Brain.Screen.setCursor(3,1);\n    Brain.Screen.print(\"PIDing\");\n\n    //  Calculate errors \n    errorX = x - currentX;\n    errorY = y - currentY;\n    errorZ = z - currentZ;\n\n    //  Accumulate integral and calculate derivative \n    integralX += errorX;\n    integralY += errorY;\n    integralZ += errorZ;\n\n    double derivativeX = errorX - prevErrorX;\n    double derivativeY = errorY - prevErrorY;\n    double derivativeZ = errorZ - prevErrorZ;\n\n    //  PID output (motor power) \n    double powerX = (kP_X * errorX) + (kI_X * integralX) + (kD_X * derivativeX);\n    double powerY = (kP_Y * errorY) + (kI_Y * integralY) + (kD_Y * derivativeY);\n    double powerZ = (kP_Z * errorZ) + (kI_Z * integralZ) + (kD_Z * derivativeZ);\n\n    //  Clamp motor power \n    //powerX = min(MAX_POWER, max(powerX, -MAX_POWER));\n    //powerY = min(MAX_POWER, max(powerY, -MAX_POWER));\n    //powerZ = min(MAX_POWER, max(powerZ, -MAX_POWER));\n    powerX = clamp(powerX, -MAX_POWER, MAX_POWER); // min(MAX_POWER, max(powerX,-MAX_POWER))\n    powerY = clamp(powerY, -MAX_POWER, MAX_POWER);\n    powerZ = clamp(powerZ, -MAX_POWER/1.5, MAX_POWER/2.5);\n\n    //  Store previous errors \n    prevErrorX = errorX;\n    prevErrorY = errorY;\n    prevErrorZ = errorZ;\n\n    //  Exit condition: all axes within threshold \n    if (fabs(errorX) < STOP_THRESHOLD &&\n        fabs(errorY) < STOP_THRESHOLD &&\n        fabs(errorZ) < STOP_THRESHOLD) {\n      break;\n    }\n\n    //  stop motors if they are within thresholds \n\n    if (fabs(errorX) < STOP_THRESHOLD) {\n      powerX = 0;\n    }\n     if (fabs(errorY) < STOP_THRESHOLD) {\n      powerY = 0;\n    }\n    if (fabs(errorZ) < STOP_THRESHOLD) {\n      powerZ = 0;\n    }\n\n\n    //  Apply to motors \n    MotorX.setVelocity(powerX, percent);\n    MotorY.setVelocity(powerY, percent);\n    MotorZ.setVelocity(powerZ, percent);\n\n    MotorX.spin(forward);\n    MotorY.spin(forward);\n    MotorZ.spin(forward);\n\n\n    wait(LOOP_DELAY, msec);\n\n\n  }\n  MotorX.stop();\n  MotorY.stop();\n  MotorZ.stop();\n  Brain.Screen.clearLine(3);\n}\n\n// x,y,z are coordinates based on the distance from the zero point in mm\nvoid moveToPIDZ(double z) {\n  Brain.Screen.clearLine(1);\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"[%.2f]\",z);\n  //  PID constants (tune these per axis)\n  double kP_Z = 1.1, kI_Z = 0.0003, kD_Z = 0.25;\n\n  //  control loop parameters \n  const double STOP_THRESHOLD = 1;  // mm tolerance\n  const int MAX_POWER = 100;          // percent\n  const int LOOP_DELAY = 20;          // ms\n\n  //  PID state variables \n  double errorZ = 0, prevErrorZ = 0, integralZ = 0;\n\n  //  Start moving (direction handled by power sign) \n  MotorZ.spin(forward);\n\n  while (true) {\n    Brain.Screen.clearLine(2);\n    Brain.Screen.setCursor(2,1);\n      //  Get current positions in mm \n    double currentZ = MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z;\n    Brain.Screen.print(\"[%.1f]\",currentZ);\n\n    Brain.Screen.clearLine(3);\n    Brain.Screen.setCursor(3,1);\n    Brain.Screen.print(\"PIDing\");\n\n    //  Calculate errors \n    errorZ = z - currentZ;\n\n    //  Accumulate integral and calculate derivative \n    integralZ += errorZ;\n\n    double derivativeZ = errorZ - prevErrorZ;\n\n    //  PID output (motor power) \n    double powerZ = (kP_Z * errorZ) + (kI_Z * integralZ) + (kD_Z * derivativeZ);\n\n    //  Clamp motor power \n    //powerX = min(MAX_POWER, max(powerX, -MAX_POWER));\n    //powerY = min(MAX_POWER, max(powerY, -MAX_POWER));\n    //powerZ = min(MAX_POWER, max(powerZ, -MAX_POWER));\n    powerZ = clamp(powerZ, -MAX_POWER/1.5, MAX_POWER/1.5);\n\n    //  Store previous errors \n    prevErrorZ = errorZ;\n\n    //  Exit condition: all axes within threshold \n    if (fabs(errorZ) < STOP_THRESHOLD) {\n      break;\n    }\n\n    //  stop motors if they are within thresholds \n    if (fabs(errorZ) < STOP_THRESHOLD) {\n      powerZ = 0;\n    }\n\n\n    //  Apply to motors \n    MotorZ.setVelocity(powerZ, percent);\n\n    MotorZ.spin(forward);\n\n    wait(LOOP_DELAY, msec);\n  }\n  MotorZ.stop();\n  Brain.Screen.clearLine(3);\n}\n\n\n\nvoid moveToBallAt(int index) {\n    // Constants for ramp geometry\n    const double THETA = atan(15/1.25); // ascent angle of the ramp in rads\n    const double RAMP_START_X = SORT_START_X;   // starting X coordinate (mm) for the first ball\n    const double RAMP_START_Z = SORT_START_Z;     // starting z coordinate (mm) for the first ball\n    const double RAMP_Y = SORT_START_Y;                  // constant Y position for all balls \n    const double BALL_DIAMETER = 32.6;   // mm\n\n    const double X_BALL_SPACING = -BALL_DIAMETER * sin(THETA); // measure theta \n    const double Z_BALL_SPACING = -BALL_DIAMETER * cos(THETA);  \n\n    // Calculate X and Z based on ball index\n    double x = RAMP_START_X + X_BALL_SPACING * index;\n    double z = RAMP_START_Z + Z_BALL_SPACING * index;\n    Brain.Screen.setCursor(4,1);\n    Brain.Screen.clearLine(4);\n    Brain.Screen.print(\"[%.1f, %.1f] \\n\", x, z);\n\n    // Move claw to that ball\n    moveToPID(x, RAMP_Y, z);\n}\n\nvoid moveToBallAtHigh(int index) {\n    // Constants for ramp geometry\n    const double THETA = atan(15/1.25); // ascent angle of the ramp in rads\n    const double RAMP_START_X = SORT_START_X;   // starting X coordinate (mm) for the first ball\n    const double RAMP_START_Z = SORT_START_Z;     // starting z coordinate (mm) for the first ball\n    const double RAMP_Y = SORT_START_Y;                  // constant Y position for all balls \n    const double BALL_DIAMETER = 32.6;   // mm\n\n    const double X_BALL_SPACING = -BALL_DIAMETER * sin(THETA); // measure theta \n    const double Z_BALL_SPACING = -BALL_DIAMETER * cos(THETA);  \n\n    // Calculate X and Z based on ball index\n    double x = RAMP_START_X + X_BALL_SPACING * index;\n    double z = RAMP_START_Z + Z_BALL_SPACING * index;\n    Brain.Screen.setCursor(4,1);\n    Brain.Screen.clearLine(4);\n    Brain.Screen.print(\"[%.1f, %.1f] \\n\", x, z);\n\n    // Move claw to that ball\n    moveToPID(x, RAMP_Y, z-BALL_DIAMETER);\n}\n\n\n\n\n\nint colorToID() {\n    // the values here are tested and then given an extra like 10 padding\n    // could not work idk should work tho\n\n    double h = Optical1.hue();         // 0–360\n    double b = Optical1.brightness();  // 0–100\n\n    // RED\n    if (h >= 10 && h <= 30 &&\n        b >= 40 && b <= 80) {\n        return 1;  \n    }\n\n    // BLUE\n    if (h >= 180 && h <= 210 &&\n        b >= 40 && b <= 80) {\n        return 2;\n    }\n\n    // WHITE\n    if (h >= 30 && h <= 50 &&\n        b >= 20 && b <= 100) {\n        return 3;  \n    }\n\n    // BLACK \n    if (h >= 30 && h <= 50 &&\n        b >= 0 && b <= 20) {\n        return 4;  \n    }\n\n    // Unknown\n    return 0;\n}\n\nvoid collectColours(int currentPositions[11]) {\n    Optical1.setLight(ledState::on);\n    Optical1.setLightPower(100,percent);\n    \n    grab();\n    moveToPID(SORT_START_X, SORT_START_Y, -45);\n    moveToPID(SORT_START_X, SORT_START_Y, 120);\n    release();\n    moveToPID(SORT_START_X, SORT_START_Y, 130);\n    moveToPID(SORT_START_X, SORT_START_Y, SORT_START_Z);\n    // grab();\n    // wait(1000, msec);\n    // moveToPID(445, -224.2, 100);\n\n    release();\n    currentPositions[0] = colorToID();\n\n    printf(\"going to colelct colors \\n\");\n    for (int i = 1; i <= 10; i++) {\n        // Move claw/sensor to current ball position\n        moveToBallAt(i);\n\n        int ballID = colorToID();\n\n        // Store ID in array\n        currentPositions[i] = ballID;\n        Brain.Screen.print(\"%d, \", currentPositions[i]);\n        if(i == 4) {           \n            Brain.Screen.newLine();\n        }\n        wait(300, msec);\n    }\n    for(int i = 0; i < 10; i++) {\n        Brain.Screen.print(\"%d, \", currentPositions[i]);\n\n        if(i == 4) {           \n            Brain.Screen.newLine();\n        }\n    }\n    wait(5000, msec);\n    Optical1.setLight(ledState::off);\n}\n\n\n    \nvoid sortBalls(int currentPositions[11]) {\n    for (int i = 0; i < 10; i++) {\n        int targetID = goal[i];  // Get the ID we need at position i\n        int foundIndex = -1;\n        int lastIndex = 10 - i;\n\n        // Find the first ball matching the target ID in the unsorted part\n        for (int j = 0; j <= lastIndex; j++) {\n            if (currentPositions[j] == targetID && foundIndex == -1) {\n                foundIndex = j;\n            }\n        }\n\n        // If we found the target ball\n        if (foundIndex != -1) {\n            // Move to that ball and grab it\n            moveToBallAtHigh(foundIndex);\n            moveToBallAt(foundIndex);\n            grab();\n            wait(1500,msec);\n            moveToPIDZ(0);\n            // Move to position i\n            moveToBallAtHigh(10);\n            release();\n\n            // Save value of picked ball\n            int pickedBall = currentPositions[foundIndex];\n\n            // Shift all balls between foundIndex and end\n            for (int k = foundIndex; k < 10; k++) {\n                currentPositions[k] = currentPositions[k + 1];\n            }\n\n            // Place the target ball at end\n            currentPositions[10] = pickedBall;\n        }\n        else {\n          Brain.Screen.clearScreen();\n          Brain.Screen.setCursor(1,1);\n          Brain.Screen.print(\"Ball ID of %d not found\", targetID);\n        }\n    }\n}\nvoid testCalibrateZ(){\n  int NORMAL_VELOCITY = 40;\n  int APPROACH_VELOCITY = 10;\n  double APPROACH_DISTANCE = 0.3;     // turns\n\n  // CALIBRATE Z:\n  MotorClaw.spin(forward);\n  MotorClaw.setVelocity(-10,percent);\n  MotorZ.spin(forward);\n  MotorZ.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  double tempPosZ = MotorZ.position(turns);\n  MotorZ.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorZ.position(turns) <= tempPosZ - APPROACH_DISTANCE)){}\n  MotorZ.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  MotorZ.setPosition(0,turns); // z-axis zeroed\n\n  wait(5,seconds);\n  moveToPID(0,0,0);\n}\n\nvoid TestCalibrateY(){\n  int NORMAL_VELOCITY = 40;\n  int APPROACH_VELOCITY = 10;\n  double APPROACH_DISTANCE = 0.3;     // turns\n\n  moveToPID(0,0,-10);\n  MotorZ.stop(hold);\n\n  MotorY.spin(forward);\n  MotorY.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  double tempPosY = MotorY.position(turns);\n  MotorY.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorY.position(turns) <= tempPosY - APPROACH_DISTANCE)){}\n  MotorY.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  MotorY.setPosition(0,turns);\n\n  wait(5,seconds);\n  moveToPID(0,0,0);\n}\n\nvoid testCalibrateX(){\n  int NORMAL_VELOCITY = 40;\n  int APPROACH_VELOCITY = 10;\n  double APPROACH_DISTANCE = 0.3;     // turns\n\n  MotorX.spin(forward);\n  MotorX.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  double tempPosX = MotorX.position(turns);\n  MotorX.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorX.position(turns) <= tempPosX - APPROACH_DISTANCE)){}\n  MotorX.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  MotorX.setPosition(0,turns); // x-axis zeroed\n\n  wait(5,seconds);\n  moveToPID(0,0,0);\n}\n\nvoid calibrate(){\n  int NORMAL_VELOCITY = 20;\n  int APPROACH_VELOCITY = 10;\n  double APPROACH_DISTANCE = 0.3;     // turns\n\n  // CALIBRATE Z:\n  MotorClaw.spin(forward);\n  MotorClaw.setVelocity(-20,percent);\n  MotorZ.spin(forward);\n  MotorZ.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  double tempPosZ = MotorZ.position(turns);\n  MotorZ.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorZ.position(turns) <= tempPosZ - APPROACH_DISTANCE)){}\n  MotorZ.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){}\n  MotorZ.setPosition(0,turns); // z-axis zeroed\n\n  moveToPID(0,0,-4);\n\n  // CALIBRATE Y:\n  MotorY.spin(forward);\n  MotorY.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-4);\n  }\n  double tempPosY = MotorY.position(turns);\n  MotorY.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorY.position(turns) <= tempPosY - APPROACH_DISTANCE)){}\n  MotorY.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-4);\n  }\n  MotorY.setPosition(0,turns); // y-axis zeroed\n  moveToPID(0,-32, -6);\n\n  // CALIBRATE X;\n  MotorX.spin(forward);\n  MotorX.setVelocity(NORMAL_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-6);\n  }\n  double tempPosX = MotorX.position(turns);\n  MotorX.setVelocity(-APPROACH_VELOCITY,percent);\n\n  while(!(MotorX.position(turns) <= tempPosX - APPROACH_DISTANCE)){}\n  MotorX.setVelocity(APPROACH_VELOCITY,percent);\n\n  while(!ClawBumper.pressing()){\n    moveToPIDZ(-6);\n  }\n  MotorX.setPosition(0,turns); // x-axis zeroed\n  moveToPID(-30,-32,-70);\n  MotorClaw.stop();\n  MotorX.stop();\n  MotorY.stop();\n  MotorZ.stop();\n}\n\nvoid release(){\n  MotorClaw.setVelocity(10, percent);\n  MotorClaw.spin(forward); \n  wait(30, msec);\n}\n\nvoid grab() {\n  MotorClaw.setVelocity(-50, percent);\n  MotorClaw.spin(forward); \n  wait(200, msec);\n  MotorClaw.setVelocity(-30, percent); // keep holding object\n}\n\nvoid openDoor()\n{\n  //array is in x, y, z\n\n  //length is 10.\n  //start (2,9,0) and end goal is (56,9,0)\n  const float startCoords[3] = {60,-200,-1}; //assumes 0,0,0 is the top left corner of pool table that touches floor\n\n  //grab();\n\n  moveToPID(startCoords[0], startCoords[1]+150, startCoords[2]-30);\n  for (int i = 0; i <=70; i+=10)\n  {\n      float angle = 3.1415926*i/180;\n      moveToPID(startCoords[0]-150.0*sin(angle), startCoords[1]+150.0*cos(angle), startCoords[2]);\n  }\n  //release();\n  moveToPID(startCoords[0], startCoords[1]+150, startCoords[2]-30); //raises it up to ensure it doesn't hit anything\n\n}\n\nvoid closeDoor()\n{\n  //array is in x, y, z\n  const float startCoords[3] = {-8,-294,-1};\n\n  // to go in reverse order, start at the 20 degree of opposite function (cosine becomes sine)\n  moveToPID(startCoords[0]-100.0*cos(3.1415*20/180), startCoords[1]+180*sin(3.1415*20/180), startCoords[2]-30);\n\n  //slowly increment change by using trigonometry\n  for (int i = 20; i <=90; i+=10)\n  {\n    float angle = 3.1415926*i/180;\n    // Since using bumper this time, needed to have it be an oval since the bumper won't be a perfect circle of travel\n    moveToPID(startCoords[0]-100.0*cos(angle), startCoords[1]+180.0*sin(angle), startCoords[2]);\n  }\n\n  //end (-250,-67,-7)\n  //start (76.6, -67, -7)\n  //max height is -103.2\n\n}\n\nvoid moveTriangle()\n{\n  const float triangleStartCoords[3] = {77, -67, -7};\n  const float triangleMidCoords[3] = {-250, -67, -7};\n  const float triangleEndCoords[3] = {40,20,0};\n\n  openDoor();\n  release();\n  moveToPID(triangleStartCoords[0], triangleStartCoords[1], triangleStartCoords[2]);\n  grab();\n  moveToPID(triangleMidCoords[0], triangleMidCoords[1], triangleMidCoords[2]);\n  \n  for (int i = 0; i <=60; i+=10)\n  {\n      float angle = 3.1415926*i/180;\n      moveToPID(triangleMidCoords[0]+50.0*sin(angle), triangleMidCoords[1], triangleMidCoords[2]-100+100.0*cos(angle));\n  }\n  //release();\n  moveToPID(triangleStartCoords[0], triangleStartCoords[1], triangleStartCoords[2]-90);\n\n  // lowers it down to the original height\n  moveToPID(triangleStartCoords[0], triangleStartCoords[1], triangleStartCoords[2]);\n\n  release();\n\n  closeDoor();\n}\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n  // Begin project code\n  Brain.Screen.clearScreen();\n  Brain.Screen.setFont(mono15);\n  MotorZ.setPosition(0,turns);\n  MotorY.setPosition(0,turns);\n  MotorX.setPosition(0,turns);  \n\n  calibrate();\n  MotorX.stop();\n  MotorY.stop();\n  MotorZ.stop();\n  MotorClaw.setVelocity(1, percent);\n  \n\n  \n \n  MotorX.setVelocity(30, percent);\n  MotorY.setVelocity(30, percent);\n  MotorZ.setVelocity(30, percent);\n\n  int currentPositions[11] = {1, 1, 4, 4, 2, 1, 2, 1, 2, 2, 3};\n  //collectColours(currentPositions);\n  //sortBalls(currentPositions);\n\n  //move triangle should work outside of the coordinates. We couldn't fully test the removing the triangle cause the battery died.\n  /*\n  while (true) {\n    double currentX = MotorX.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;\n    double currentY = MotorY.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_XY;\n    double currentZ = MotorZ.position(turns) * TOOTH_PITCH_MM * NUM_TEETH_Z;\n    int ID = colorToID();\n    printf(\"in loop!\");\n    // Print hue, brightness, and color\n    Brain.Screen.clearLine(1);\n    Brain.Screen.setCursor(1,1);\n    //Brain.Screen.print(\"[%.1f, %.1f, %.1f]\", currentX,currentY,currentZ); \n    printf(\"[%.1f, %.1f, %.1f]\", currentX,currentY,currentZ); \n    //Brain.Screen.print(\"ID: %d [h, b] = [%.2f, %.2f] \\n\" , ID, Optical1.hue(), Optical1.brightness());\n\n    wait(1000, msec);\n  }*/\n\n\n  \n  \n}\n\n// first ball\n\n// 189, -224.2, ","textLanguage":"cpp","robotConfig":[{"port":[4],"name":"MotorX","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[6],"name":"MotorZ","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[12],"name":"MotorY","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"ClawBumper","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[9],"name":"MotorClaw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"MotorX","leftDir":"false","right":"MotorZ","rightDir":"false","e":"MotorY","eDir":"false","f":"MotorClaw","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[1],"name":"Optical1","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":""}}